    </xs:complexType>
    <!-- Ende WGM-Ergänzung -->
    <!-- WGM-Ergänzung: controlaccess-Element mit Subelementen -->
    <xs:complexType name="controlaccess">
        <xs:sequence>
            <xs:element name="list" type="wgm.list"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="wgm.list">
        <xs:sequence minOccurs="1" maxOccurs="unbounded">
            <xs:element name="item" type="wgm.item"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="wgm.item">
        <xs:sequence minOccurs="1" maxOccurs="1">
            <xs:choice minOccurs="1" maxOccurs="1">
                <xs:element name="name">
                    <xs:alternative test="@role = 'WGM-ID'" type="wgm.wgm_id"/>
                    <xs:alternative test="@role = 'Rolle'" type="wgm.rolle"/>
                    <xs:alternative test="@role = 'akademischer Titel'"
                        type="wgm.akademischer_titel"/>
                    <xs:alternative test="@role = 'Geschlecht'" type="wgm.geschlecht"/>
                    <xs:alternative
                        test="@role = 'erlernter Beruf' or @role = 'Beruf bei Antragstellung'"
                        type="wgm.beruf"/>
                    <!-- NEU! Korrektur Beziehung zur antragstellenden Person -->
                    <xs:alternative
                        test="@role = 'Beziehung zur verfolgten Person' or @role = 'Beziehung zur antragstellenden Person'"
                        type="wgm.beziehung"/>
                    <xs:alternative test="@role = 'Verfolgungsgrund'" type="wgm.verfolgungsgrund"/>
                    <xs:alternative test="@role = 'Verfolgungsgrund Spezifizierung'"
                        type="wgm.verfolgungsgrund_spezifizierung"/>
                    <xs:alternative test="@role = 'Verfolgungsgegenstand'"
                        type="wgm.verfolgungsgegenstand"/>
                    <!-- NEU! Entfernung Emigration -->
                    <xs:alternative
                        test="@role = 'Illegalität' or @role = 'Zwangsarbeit'"
                        type="wgm.illegalitaet_zwangsarbeit"/>
                    <xs:alternative test="@role = 'Zwangssterilisierung'"
                        type="wgm.zwangssterilisierung"/>
                    <xs:alternative
                        test="@role = 'Deportation, Inhaftierung, Anstaltsunterbringung'"
                        type="wgm.deportation"/> 
                </xs:element>
                <xs:element name="corpname" type="wgm.corpname"/>
                <xs:element name="persname" type="wgm.persname"/>
                <!-- NEU! Ergänzung Sterbeort sowie Emigration  -->
                <xs:sequence>
                    <xs:element name="geogname" minOccurs="0" maxOccurs="unbounded">
                        <xs:alternative
                            test="@role = 'Geburtsort' or @role = 'Sterbeort' or @role = 'Sterbeort vor 1947' or @role = 'letzter Wohnort' or @role = 'Wohnort bei Antragstellung' or @role = 'Sitz' or @role = 'Wohnort bei Entziehung'"
                            type="wgm.ort"/>
                        <xs:alternative
                            test="@role = 'Staatsangehörigkeit vor der Verfolgung' or @role = 'Staatsangehörigkeit bei Antragstellung'  or @role = 'Emigration'"
                            type="wgm.staaten"/>
                    </xs:element>
                    <xs:element name="note" minOccurs="0" maxOccurs="1">
                        <xs:alternative
                            test="@label = 'Geburtsort' or @label = 'Sterbeort vor 1947' or @label = 'letzter Wohnort' or @label = 'Wohnort bei Antragstellung' or @label = 'Sitz'"
                            type="wgm.ort_note"/>
                        <xs:alternative test="not(@label)" type="wgm.item.note"/>
                    </xs:element>
                </xs:sequence>
                <xs:element name="date" type="wgm.date"/>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>
