            <xs:group ref="m.render"/>
        </xs:choice>-->
    </xs:complexType>
    <!-- verschiedenen level Ebenen/archedesc-->
    <xs:complexType name="archdesc">
        <xs:sequence>
            <xs:element name="did" type="did.archdesc"/>
            <xs:group ref="m.desc.full.archdesc" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="level" type="av.level" use="required" fixed="collection"/>
        <xs:attribute name="type" fixed="Findbuch" use="required"/>
    </xs:complexType>
    <xs:complexType name="c.collection">
        <xs:sequence>
            <xs:element name="did" type="did.collection"/>
            <xs:group ref="m.desc.full.collection" minOccurs="0" maxOccurs="unbounded"/>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="c">
                    <xs:alternative test="@level = 'collection'" type="c.collection"/>
                    <xs:alternative test="@level = 'class'" type="c.class_series"/>
                    <xs:alternative test="@level = 'series'" type="c.class_series"/>
                    <xs:alternative test="@level = 'file'" type="c.file"/>
                    <!--<xs:alternative
                        test="((((@level != 'file')) and (@level != 'collection')) and (@level != 'class')) and (@level != 'series')"
                        type="c.file"/>-->
                </xs:element>
            </xs:choice>
        </xs:sequence>
        <xs:attributeGroup ref="a.desc.c.collection"/>
    </xs:complexType>
    <xs:complexType name="c.class_series">
        <xs:sequence>
            <xs:element name="did" type="did.class_series"/>
            <xs:group ref="m.desc.full.class_series" minOccurs="0" maxOccurs="unbounded"/>
