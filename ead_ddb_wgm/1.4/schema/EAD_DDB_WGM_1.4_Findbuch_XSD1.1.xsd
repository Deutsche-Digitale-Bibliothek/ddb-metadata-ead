    </xs:complexType>
    <xs:complexType name="wgm.provenienzforschung" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.provenienzforschung.role"/>
        <xs:attributeGroup ref="wgm.provenienzforschung.normal"/>
    </xs:complexType>
    <!-- NEU! Entfernung Ort des Vermögens -->
    <!-- xs:complexType name="wgm.index.ort" mixed="true">
        <xs:attributeGroup ref="wgm.index.ort.role"/>
        <xs:attributeGroup ref="a.access"/>
    </xs:complexType -->
    <xs:complexType name="wgm.bewegliches_vermoegen" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.bewegliches_vermoegen.role"/>
        <xs:attributeGroup ref="wgm.bewegliches_vermoegen.normal"/>
    </xs:complexType>
    <xs:complexType name="wgm.unbewegliches_vermoegen" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.unbewegliches_vermoegen.role"/>
        <xs:attributeGroup ref="wgm.unbewegliches_vermoegen.normal"/>
