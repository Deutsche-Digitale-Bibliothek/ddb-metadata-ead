    <!-- WGM-Ergänzung: name sowie types für geogname, corpname, name und persname-->
    <xs:group name="m.access">
        <xs:choice>
            <!-- NEU! Entfernung der Abprüfung auf Ort des Vermögens -->
            <xs:element name="geogname">
                <xs:alternative
                    test="not(@role = 'unbewegliches Vermögen')" 
                    type="geogname"/>
                <xs:alternative test="@role = 'unbewegliches Vermögen'" 
                    type="wgm.unbewegliches_vermoegen"/> 
            </xs:element>
            <xs:element name="persname">
                <xs:alternative
                    test="not(@role = 'andere Person oder Institution' or @role = 'Miterben' or @role = 'Antragsgegner')"
                    type="persname"/>
                <xs:alternative test="@role = 'andere Person oder Institution'"
                    type="wgm.person_institution"/>
                <xs:alternative test="@role = 'Miterben'" type="wgm.miterben"/>
                <xs:alternative test="@role = 'Antragsgegner'" type="wgm.antragsgegner"/>
            </xs:element>
            <xs:element name="subject" type="subject"/>
            <xs:element name="corpname">
                <xs:alternative
                    test="not(@role = 'andere zuständige Behörde' or @role = 'andere Person oder Institution' or @role = 'BZK zuständiges Archiv' or @role = 'Miterben' or @role = 'Antragsgegner')"
                    type="index.corpname"/>
                <xs:alternative test="@role = 'andere zuständige Behörde'"
                    type="wgm.zustaendige_behoerde"/>
                <xs:alternative test="@role = 'andere Person oder Institution'"
                    type="wgm.person_institution"/>
                <xs:alternative test="@role = 'BZK zuständiges Archiv'" type="wgm.bzk_archiv"/>
                <xs:alternative test="@role = 'Miterben'" type="wgm.miterben"/>
                <xs:alternative test="@role = 'Antragsgegner'" type="wgm.antragsgegner"/>
            </xs:element>
            <xs:element name="name">
                <xs:alternative
                    test="not(@role = 'Schadensarten' or @role = 'Provenienzforschung' or @role = 'bewegliches Vermögen' or @role = 'unbewegliches Vermögen' or @role = 'Geldwerte')"
                    type="index.name"/>
                <xs:alternative test="@role = 'Provenienzforschung'" type="wgm.provenienzforschung"/>
                <xs:alternative test="@role = 'Schadensarten'" type="wgm.schadensarten"/>
                <xs:alternative test="@role = 'bewegliches Vermögen'"
                    type="wgm.bewegliches_vermoegen"/>
                <xs:alternative test="@role = 'Geldwerte'" type="wgm.geldwerte"/>
            </xs:element>
        </xs:choice>
    </xs:group>
    <xs:complexType name="index.name" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attribute name="role"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attribute name="normal" use="optional"/>
    </xs:complexType>
    <!-- Ende WGM-Ergänzung -->
    <xs:complexType name="geogname" mixed="true">
        <xs:attributeGroup ref="a.access"/>
        <xs:attribute name="role"/>
    </xs:complexType>
    <xs:complexType name="persname" mixed="true">
        <xs:attributeGroup ref="a.access"/>
        <xs:attribute name="role"/>
    </xs:complexType>
    <xs:complexType name="subject" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attribute name="role"/>
        <xs:attributeGroup ref="a.access"/>
    </xs:complexType>
    <xs:complexType name="index.corpname" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attribute name="role"/>
    </xs:complexType>
