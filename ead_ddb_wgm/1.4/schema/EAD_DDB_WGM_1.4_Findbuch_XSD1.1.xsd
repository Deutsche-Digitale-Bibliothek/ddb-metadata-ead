        <xs:sequence>
            <xs:element name="titlestmt" type="titlestmt"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="titlestmt">
        <xs:sequence>
            <xs:element name="titleproper" type="titleproper"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="profiledesc">
        <xs:sequence>
            <xs:element name="creation" type="creation"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="creation" mixed="false">
        <xs:choice>
            <xs:element name="date" type="date_normal"/>
        </xs:choice>
