        <xs:attributeGroup ref="wgm.verfolgungsgrund.normal"/>
    </xs:complexType>
    <xs:complexType name="wgm.verfolgungsgrund_spezifizierung" mixed="true">
        <xs:attributeGroup ref="wgm.verfolgungsgrund_spezifizierung.role"/>
        <xs:attributeGroup ref="wgm.verfolgungsgrund_spezifizierung.normal"/>
    </xs:complexType>
    <!-- NEU! Attribut-Gruppe a.access hinzugefügt, um Normdatenverknüpfung zu erlauben.  -->
    <xs:complexType name="wgm.verfolgungsgegenstand" mixed="true">
        <xs:attributeGroup ref="wgm.verfolgungsgegenstand.role"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.verfolgungsgegenstand.normal"/>
    <!-- NEU! Entfernung Emigration  -->
    </xs:complexType>
    <xs:complexType name="wgm.illegalitaet_zwangsarbeit" mixed="true">
        <xs:attributeGroup ref="wgm.illegalitaet_zwangsarbeit.role"/>
        <xs:attributeGroup ref="wgm.ja_nein.normal"/>
    </xs:complexType>
    <!-- NEU! Attribut-Gruppe a.access und wgm.deportation.normal hinzugefügt, um Normdatenverknüpfung und Listenwerte zu erlauben.  -->
    <xs:complexType name="wgm.deportation" mixed="true">
        <xs:attributeGroup ref="wgm.deportation.role"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.deportation.normal"/>
    </xs:complexType>
    <xs:complexType name="wgm.zwangssterilisierung">
        <xs:attributeGroup ref="wgm.zwangssterilisierung.role"/>
        <xs:attributeGroup ref="wgm.ja_nein.normal"/>
    </xs:complexType>
    <!-- Bearbeitung gegenüber Schema Version 1.1: Attribut-Gruppe a.access entfernt, da die Normdaten bereits im Element wgm.wgm_id abgedeckt sind.  -->
    <xs:complexType name="wgm.corpname" mixed="true">
        <xs:attributeGroup ref="wgm.corpname.role"/>
    </xs:complexType>
    <xs:complexType name="wgm.persname" mixed="true">
        <xs:attributeGroup ref="wgm.persname.role"/>
    </xs:complexType>
    <xs:complexType name="wgm.ort" mixed="true">
        <xs:attributeGroup ref="wgm.ort.role"/>
        <xs:attributeGroup ref="a.access"/>
    </xs:complexType>
    <!-- NEU! Änderung von wgm.staatsangehörigkeit zu wgm.staaten -->
    <xs:complexType name="wgm.staaten">
        <xs:attributeGroup ref="wgm.staaten.role"/>
        <xs:attributeGroup ref="wgm.staaten.normal"/>
