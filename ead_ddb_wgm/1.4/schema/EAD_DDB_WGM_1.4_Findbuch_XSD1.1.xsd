    <xs:complexType name="wgm.zustaendige_behoerde" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.zustaendige_behoerde.role"/>
    </xs:complexType>
    <xs:complexType name="wgm.bzk_archiv" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.bzk_archiv.role"/>
    </xs:complexType>
    <xs:complexType name="wgm.person_institution" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.person_institution.role"/>
    </xs:complexType>
    <xs:complexType name="wgm.miterben" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.miterben.role"/>
    </xs:complexType>
    <xs:complexType name="wgm.antragsgegner" mixed="true">
        <xs:group ref="m.render" minOccurs="0" maxOccurs="unbounded"/>
        <xs:attributeGroup ref="a.access"/>
        <xs:attributeGroup ref="wgm.antragsgegner.role"/>
    </xs:complexType>
